{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/sitemap.mjs": {
      "maxDuration": 10
    },
    "api/event-preview.mjs": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/:page(dashboard|saved|profile|login|register|admin)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/users/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/events/new",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/events/:id/edit",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/events/:id",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/sitemap",
      "destination": "/api/sitemap"
    },
    {
      "source": "/events/:id([0-9a-fA-F-]{36})",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|discordbot|Twitterbot|facebookexternalhit|Facebot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/event-preview?id=:id"
    },
    {
      "source": "/api/event-preview",
      "destination": "/api/event-preview"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
