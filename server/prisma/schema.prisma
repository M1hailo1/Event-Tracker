// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  googleId  String?  @unique
  name      String
  role      Role     @default(USER)
  isBanned  Boolean  @default(false)
  createdAt DateTime @default(now())

  events        Event[]        @relation("EventCreator")
  registrations Registration[]
  categories    Category[]

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  notifications Notification[]
  eventInvites  EventInvite[]
}

model Category {
  id              String   @id @default(uuid())
  name            String
  isCustom        Boolean  @default(false)
  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id])

  events Event[]
}

enum RecurrencePattern {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  FOLLOWERS_ONLY
  INVITE_ONLY
}

model Event {
  id                String             @id @default(uuid())
  name              String
  description       String?
  date              DateTime
  endDate           DateTime?
  location          String
  latitude          Float
  longitude         Float
  maxCapacity       Int?
  isRecurring       Boolean            @default(false)
  recurrencePattern RecurrencePattern?
  visibility        EventVisibility    @default(PUBLIC)
  createdAt         DateTime           @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdByUserId String
  createdBy       User   @relation("EventCreator", fields: [createdByUserId], references: [id])

  registrations Registration[]
  invites       EventInvite[]

  parentEventId String?
  parentEvent   Event?  @relation("EventSeries", fields: [parentEventId], references: [id])
  nextInstances Event[] @relation("EventSeries")
}

model EventInvite {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])
  invitedUserId String
  invitedUser   User     @relation(fields: [invitedUserId], references: [id])
  invitedAt     DateTime @default(now())

  @@unique([eventId, invitedUserId])
}

model Registration {
  id            String             @id @default(uuid())
  status        RegistrationStatus @default(PENDING)
  registeredAt  DateTime           @default(now())
  reminderSent  Boolean            @default(false)

  userId  String
  user    User   @relation(fields: [userId], references: [id])

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id])
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

enum NotificationType {
  NEW_EVENT_FROM_FOLLOWED
  EVENT_UPDATED
  EVENT_CANCELLED
  EVENT_REMINDER
  NEW_FOLLOWER
  EVENT_INVITE
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String
  eventId   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}